---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Nav from "../../components/Nav.astro";
import FooterCTA from "../../components/FooterCTA.astro";
import StatusBar from "../../components/StatusBar.astro";
import BookingCTA from "../../components/BookingCTA.astro";
import { websiteJsonLd, servicesJsonLd, servicesBreadcrumbJsonLd } from "../../lib/schema";
import { services } from "../../lib/services-data";
---

<BaseLayout
  title="Services — Saadiq Rodgers-King"
  description="Five engagement shapes, from a single talk to ongoing technical leadership. Talks, executive advisory, discovery sprints, agent builds, and embedded leadership."
  ogImage="/services/og.png"
  jsonLd={[websiteJsonLd, servicesJsonLd, servicesBreadcrumbJsonLd]}
>
  <Nav />
  <main class="pt-40 md:pt-48 pb-20 md:pb-28">
    <div class="container-wide">
      <h1 class="page-title">
        How I work
      </h1>
      <p class="text-xl md:text-2xl text-text-body mb-6 max-w-3xl">
        I get product and engineering teams actually using AI. For companies
        without those teams, I build the systems and stay until they run
        without me.
      </p>
      <p class="text-text-body leading-relaxed mb-16 max-w-2xl">
        A talk seeds the idea, a sprint proves it on your real work, a build
        ships it. Engagements start with a scoped, fixed-fee first project.
        Scope expands only when results earn it.
      </p>

      <div class="pt-12 mb-16 md:mb-20">
        <h2 class="rule-heading mb-8">At a glance</h2>
        {/* One grid on the container, rows as subgrid. Each row used to be its
            own grid, so the column widths were recomputed per row and nothing
            lined up down the table. */}
        <div class="panel divide-y divide-rule px-5 md:px-7 md:grid md:grid-cols-[1fr_1fr_auto]">
          {
            services.map((service) => (
              <a
                href={`#${service.slug}`}
                class="grid grid-cols-1 md:col-span-3 md:grid-cols-subgrid items-baseline gap-x-8 gap-y-1 py-4 group"
                data-ph-capture="section_jump"
                data-ph-section="services_index"
                data-ph-destination={service.slug}
              >
                <span class="font-mono text-sm text-accent group-hover:text-accent-hover transition-colors">
                  {service.name.toLowerCase()}_
                </span>
                <span class="text-sm text-text-body">for {service.forShort}</span>
                <span class="font-mono text-xs text-text-muted md:text-right">{service.shape}</span>
              </a>
            ))
          }
        </div>
      </div>

      <div class="space-y-6">
        {
          services.map((service) => (
            <div
              id={service.slug}
              class="panel grid md:grid-cols-2 gap-6 md:gap-16 p-6 md:p-10"
            >
              <div>
                <h2 class="font-display text-3xl md:text-4xl leading-tight mb-4">
                  {service.name}
                </h2>
                <div class="space-y-1">
                  {service.format.map((line) => (
                    <p class="font-mono text-xs text-text-muted">{line}</p>
                  ))}
                </div>
              </div>
              <div>
                <p class="text-text leading-relaxed mb-4">{service.who}</p>
                <p class="text-text-body leading-relaxed mb-6">
                  {service.body}
                </p>
                <p class="font-mono text-xs text-text-muted mb-2">proof_</p>
                <p class="text-sm text-text-body leading-relaxed mb-6">
                  {service.proof}
                </p>
                <BookingCTA
                  section={`services_${service.slug}`}
                  variant="text"
                  label={service.cta}
                />
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </main>
  <FooterCTA />
  <StatusBar />
</BaseLayout>

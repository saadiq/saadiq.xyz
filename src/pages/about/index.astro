---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Nav from "../../components/Nav.astro";
import FooterCTA from "../../components/FooterCTA.astro";
import StatusBar from "../../components/StatusBar.astro";
import BookingCTA from "../../components/BookingCTA.astro";
import { Image } from "astro:assets";
import portrait from "../../assets/images/portrait.jpg";
import { aboutJsonLd, websiteJsonLd, aboutBreadcrumbJsonLd } from "../../lib/schema";
---

<BaseLayout
  title="About — Saadiq Rodgers-King"
  description="Saadiq Rodgers-King. Princeton CS, MIT Sloan MBA. 20+ years building products. I get product and engineering teams actually using AI."
  ogImage="/about/og.png"
  jsonLd={[websiteJsonLd, aboutJsonLd, aboutBreadcrumbJsonLd]}
>
  <Nav />
  <main class="pt-40 md:pt-48 pb-20 md:pb-28">
    <div class="max-w-5xl mx-auto px-6">
      <!-- Name block -->
      <p class="section-label mb-8">// about</p>
      <h1 class="font-display text-5xl md:text-6xl lg:text-7xl mb-6">
        Saadiq Rodgers-King
      </h1>
      <p class="text-xl md:text-2xl text-text-muted mb-12 max-w-2xl">
        I get product and engineering teams actually using AI.
      </p>

      <!-- Metadata block -->
      <div class="border-t border-rule pt-12 mb-12">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6 md:gap-4 mb-8">
          <div>
            <p class="font-mono text-xs text-text-muted">location_</p>
            <p class="font-mono text-sm text-text">Brooklyn, NY</p>
          </div>
          <div>
            <p class="font-mono text-xs text-text-muted">education_</p>
            <p class="font-mono text-sm text-text">Princeton CS, MIT Sloan MBA</p>
          </div>
          <div>
            <p class="font-mono text-xs text-text-muted">experience_</p>
            <p class="font-mono text-sm text-text">20+ years</p>
          </div>
          <div>
            <p class="font-mono text-xs text-text-muted">focus_</p>
            <p class="font-mono text-sm text-text">AI transformation consulting</p>
          </div>
        </div>
        <div>
          <p class="font-mono text-xs text-text-muted">exits_</p>
          <p class="font-mono text-sm text-text">
            <span class="whitespace-nowrap">Hot Potato <span class="text-text-muted">&rarr;</span> Facebook</span> ·
            <span class="whitespace-nowrap">Nodejitsu <span class="text-text-muted">&rarr;</span> GoDaddy</span> ·
            <span class="whitespace-nowrap">Fabric <span class="text-text-muted">&rarr;</span> Gerber Life</span> ·
            <span class="whitespace-nowrap">PROOF <span class="text-text-muted">&rarr;</span> Yuga Labs</span>
          </p>
        </div>
      </div>

      <!-- Bio section -->
      <div class="border-t border-rule pt-12">
        <div class="grid md:grid-cols-3 gap-12">
          <div>
            <Image
              src={portrait}
              alt="Saadiq Rodgers-King"
              widths={[400, 620, 886]}
              sizes="(min-width: 768px) 310px, min(100vw - 3rem, 24rem)"
              class="w-full max-w-sm border border-rule"
              loading="eager"
            />
          </div>
          <div class="md:col-span-2">
            <p class="text-lg md:text-xl leading-relaxed mb-8">
              I've spent my career at the intersection of product, engineering, and strategy.
              I started as an engineer at MLB.com, building web applications that served over
              1.5 billion visitors. I founded Hot Potato (acquired by Facebook), ran operations
              at Nodejitsu (acquired by GoDaddy), and led product at Fabric (acquired by Gerber
              Life) and PROOF (acquired by Yuga Labs).
            </p>
            <p class="text-text-muted leading-relaxed mb-8">
              Zero-to-one startups through public companies. Consumer internet, fintech, Web3,
              enterprise SaaS. Four of those companies exited.
            </p>
            <p class="text-text-muted leading-relaxed mb-8">
              Now I get product and engineering teams actually using AI. Not the conference-talk
              version. The real version. Your team changes how they work, the tools are set up
              for your context, and the results show up in the work product.
            </p>
            <p class="text-text-muted leading-relaxed mb-8">
              I've been fully AI-native since 2024, running my own work through the same systems
              I set up for clients. I embed with your team, work on real outcomes, and when I'm
              done, the capability is theirs. I know what high performance with these tools looks
              like firsthand.
            </p>
            <p class="text-text-muted leading-relaxed mb-12">
              If you're a CEO or CPO at a tech company where the team has the tools but
              nothing's changed, I can show you what the path forward looks like.
            </p>
            <BookingCTA section="about" variant="text" />
            <div class="flex gap-6 mt-8">
              <a
                href="https://www.linkedin.com/in/saadiq/"
                target="_blank"
                rel="noopener noreferrer"
                class="text-link text-text-muted hover:text-text"
                data-ph-capture="outbound_click"
                data-ph-section="about"
                data-ph-destination="linkedin"
              >
                LinkedIn →
              </a>
              <a
                href="https://github.com/saadiq"
                target="_blank"
                rel="noopener noreferrer"
                class="text-link text-text-muted hover:text-text"
                data-ph-capture="outbound_click"
                data-ph-section="about"
                data-ph-destination="github"
              >
                GitHub →
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
  <FooterCTA />
  <StatusBar />
</BaseLayout>

---
// Persistent: the mark (home and brand) and Book (the one conversion). On
// desktop the page links and /newsletter sit in the bar; below md they fold
// into a menu so the bar stays one row. The footer form covers the newsletter
// on every page, so it never needs a persistent slot on mobile.
import BookingCTA from "./BookingCTA.astro";
import NavLinks from "./NavLinks.astro";
import Mark from "./Mark.astro";

---

<nav
  id="main-nav"
  class="fixed top-0 left-0 right-0 z-50 transition-colors duration-300 pl-[env(safe-area-inset-left)] pr-[env(safe-area-inset-right)]"
>
  <div class="flex items-center justify-between px-6 py-2 md:px-10 md:py-3">
    <a href="/" class="inline-flex min-h-11 items-center gap-3 text-text no-underline">
      <span class="flex size-8 items-center justify-center bg-text text-bg">
        <Mark class="size-5" />
      </span>
      <span class="max-sm:sr-only font-display text-lg font-extrabold tracking-tight">Saadiq Industries</span>
    </a>

    <div class="flex items-center gap-4 md:gap-8 text-sm font-medium">
      <NavLinks linkClass="hidden md:inline-flex min-h-11" />
      <BookingCTA section="nav" variant="outline" label="Book" />
      <button
        id="nav-menu-toggle"
        type="button"
        class="inline-flex min-h-11 items-center text-text-muted hover:text-text md:hidden"
        aria-expanded="false"
        aria-controls="nav-menu"
      >
        Menu
      </button>
    </div>
  </div>

  <div
    id="nav-menu"
    class="hidden px-6 pb-4 md:hidden"
  >
    <div class="flex flex-col text-lg font-medium">
      <NavLinks linkClass="flex min-h-12 border-t border-rule" />
    </div>
  </div>
</nav>

<script>
  const nav = document.getElementById("main-nav");
  const toggle = document.getElementById("nav-menu-toggle");
  const menu = document.getElementById("nav-menu");

  if (nav && toggle && menu) {
    let open = false;
    // The nav takes its glass background and single bottom rule once scrolled,
    // or while the menu is open, so the menu never draws a second rule.
    const paint = () => {
      const solid = open || window.scrollY > 50;
      for (const c of ["backdrop-blur-md", "border-b", "border-rule"]) {
        nav.classList.toggle(c, solid);
      }
      nav.classList.toggle("bg-bg/80", solid && !open);
      nav.classList.toggle("bg-bg/95", open);
    };
    const setOpen = (next: boolean) => {
      open = next;
      menu.classList.toggle("hidden", !open);
      toggle.setAttribute("aria-expanded", String(open));
      toggle.textContent = open ? "Close" : "Menu";
      paint();
    };

    window.addEventListener("scroll", paint, { passive: true });
    paint();

    toggle.addEventListener("click", () => setOpen(!open));
    menu.addEventListener("click", (e) => {
      if ((e.target as HTMLElement).closest("a")) setOpen(false);
    });
    document.addEventListener("click", (e) => {
      if (open && !nav.contains(e.target as Node)) setOpen(false);
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && open) {
        setOpen(false);
        toggle.focus();
      }
    });
  }
</script>

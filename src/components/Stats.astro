---
const stats = [
  {
    number: "74%",
    caption: "CEOs who fear losing their jobs over AI within 2 years",
    source: "Dataiku / Harris Poll",
    url: "https://fortune.com/2025/05/09/ceos-fear-losing-jobs-ai-survey/",
  },
  {
    number: "95%",
    caption: "AI pilots that fail to deliver ROI",
    source: "MIT",
    url: "https://fortune.com/2025/08/18/mit-report-95-percent-generative-ai-pilots-at-companies-failing-cfo/",
  },
  {
    number: "80%+",
    caption: "Report NO productivity gains despite 70% using AI",
    source: "NBER",
    url: "https://fortune.com/2026/02/17/ai-productivity-paradox-ceo-study-robert-solow-information-technology-age/",
  },
  {
    number: "42%",
    caption: "Abandoned majority of AI projects before production",
    source: "S&P Global via CIO Dive",
    url: "https://www.ciodive.com/news/AI-project-fail-data-SPGlobal/742590/",
  },
];
---

<section class="py-20 md:py-28 border-t border-rule">
  <div class="max-w-5xl mx-auto px-6">
    <p class="section-label mb-12">// the problem</p>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 md:gap-12 mb-12">
      {stats.map((stat) => (
        <div>
          <p class="font-display text-4xl md:text-5xl text-accent mb-2">
            {stat.number}
          </p>
          <p class="font-mono text-xs text-text-muted leading-relaxed">
            {stat.caption}
          </p>
          <a
            href={stat.url}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-1 inline-flex min-h-6 items-center font-mono text-xs text-text-muted underline decoration-text-muted/40 underline-offset-2 hover:text-accent transition-colors"
          >
            — {stat.source}
          </a>
        </div>
      ))}
    </div>

    <p class="text-lg md:text-xl text-text-muted max-w-2xl">
      The tools exist. The results don't. The gap is not access. It's knowing what to aim for.
    </p>
  </div>
</section>

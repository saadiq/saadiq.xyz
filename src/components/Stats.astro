---
const stats = [
  {
    number: "10-15%",
    caption: "Copilot seats in use across the Fortune 500, two years in",
    source: "Tim Kellogg",
    url: "https://timkellogg1.substack.com/p/you-cant-sell-an-agent",
  },
  {
    number: "6%",
    caption:
      "Executives who can point to org-wide AI ROI. 89% say AI made work faster",
    source: "Atlassian State of Teams, via SVPG",
    url: "https://www.svpg.com/the-ai-productivity-paradox/",
  },
  {
    number: "30%",
    caption: "Gain in shipped releases, from a 180% gain in code written",
    source: "MIT Sloan / Wharton, 100k developers",
    url: "https://papers.ssrn.com/sol3/papers.cfm?abstract_id=6843118",
  },
  {
    number: "50x",
    caption:
      "What the top decile of firms spends per employee on AI, against the median",
    source: "Ramp data, via a16z",
    url: "https://www.a16z.news/p/charts-of-the-week-head-in-the-neoclouds",
  },
];
---

<section class="pb-20 md:pb-28">
  <div class="container-wide">
    <h2 class="sr-only">The problem</h2>

    <div class="panel grid grid-cols-2 lg:grid-cols-4 gap-y-10 py-10 md:py-14">
      {stats.map((stat, i) => (
        <div class:list={[
          "px-5 md:px-10",
          i % 2 === 1 && "border-l border-rule",
          i === 2 && "lg:border-l lg:border-rule",
        ]}>
          <p class="font-display text-5xl md:text-7xl lg:text-6xl xl:text-8xl leading-[0.9] whitespace-nowrap text-accent mb-4">
            {stat.number}
          </p>
          <p class="font-mono text-xs text-text-muted leading-relaxed">
            {stat.caption}
          </p>
          <a
            href={stat.url}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-1 inline-flex min-h-6 items-center font-mono text-xs text-text-muted underline decoration-text-muted/40 underline-offset-2 hover:text-accent transition-colors"
          >
            — {stat.source}
          </a>
        </div>
      ))}
    </div>

    <p class="font-display text-3xl md:text-[2.75rem] leading-tight text-text max-w-4xl mt-16 md:mt-20">
      The tools exist. The results don't. The gap is not access. It's knowing what to aim for.
    </p>
  </div>
</section>

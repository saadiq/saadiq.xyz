---
// Inline newsletter signup posting to the Ghost Members API at /newsletter.
// Ghost sends the confirmation magic link; no keys involved.
interface Props {
  section: string;
}
const { section } = Astro.props;
---

<form
  data-newsletter-form
  data-ph-section={section}
  class="flex flex-wrap items-center gap-3 max-w-md"
  novalidate
>
  <label class="sr-only" for={`newsletter-email-${section}`}>Email address</label>
  <input
    id={`newsletter-email-${section}`}
    type="email"
    name="email"
    required
    placeholder="you@company.com"
    autocomplete="email"
    class="flex-1 min-w-48 min-h-11 bg-transparent border border-rule px-4 py-2.5 font-mono text-sm text-text placeholder:text-text-muted/80 focus:border-accent transition-colors"
  />
  {/* Honeypot. Off-screen, out of the tab order, hidden from assistive tech, and
      named so no autofill heuristic matches it, so no real visitor can fill it. */}
  <div class="absolute -left-[9999px] w-px h-px overflow-hidden" aria-hidden="true">
    <label for={`newsletter-hp-${section}`}>Leave this field empty</label>
    <input
      id={`newsletter-hp-${section}`}
      data-newsletter-hp
      type="text"
      name="nl-hp"
      tabindex="-1"
      autocomplete="off"
    />
  </div>
  <button
    type="submit"
    class="min-h-11 font-mono text-sm text-accent hover:text-accent-hover border border-rule hover:border-accent px-4 py-2.5 transition-colors cursor-pointer disabled:opacity-50 disabled:cursor-wait"
  >
    Subscribe &rarr;
  </button>
  <p data-newsletter-msg class="w-full font-mono text-xs text-text-muted min-h-4" aria-live="polite"></p>
</form>

<script>
  const GHOST_API = "/newsletter/members/api";
  const FAILURE_HTML =
    'That did not go through. <a href="/newsletter" rel="noreferrer" class="text-accent">Subscribe on the newsletter page</a> instead.';

  // What Ghost's member-attribution script recorded for this tab. Portal sends
  // the same array as urlHistory; without it every signup here reads as direct.
  function urlHistory(): unknown[] | undefined {
    try {
      const raw = sessionStorage.getItem("ghost-history");
      if (!raw) return undefined;
      const parsed = JSON.parse(raw);
      return Array.isArray(parsed) ? parsed : undefined;
    } catch {
      // Storage access throws outright in some privacy modes.
      return undefined;
    }
  }

  async function subscribe(email: string): Promise<boolean> {
    let integrityToken = "";
    try {
      const t = await fetch(`${GHOST_API}/integrity-token/`, {
        headers: { "app-pragma": "no-cache" },
      });
      // A fall-through route can answer 200 with an HTML page; only accept a
      // bare token, never a document body.
      if (t.ok) {
        const body = (await t.text()).trim();
        if (body && body.length < 512 && !/[\s<>]/.test(body)) integrityToken = body;
      }
    } catch {
      // Older Ghost versions have no integrity token endpoint.
    }
    const history = urlHistory();
    const res = await fetch(`${GHOST_API}/send-magic-link/`, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        email,
        emailType: "signup",
        ...(integrityToken ? { integrityToken } : {}),
        ...(history ? { urlHistory: history } : {}),
      }),
    });
    return res.ok;
  }

  document.querySelectorAll<HTMLFormElement>("[data-newsletter-form]").forEach((form) => {
    let sending = false;
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (sending) return;
      const input = form.querySelector<HTMLInputElement>("input[type=email]");
      const msg = form.querySelector<HTMLElement>("[data-newsletter-msg]");
      const button = form.querySelector<HTMLButtonElement>("button[type=submit]");
      if (!input || !msg) return;
      const email = input.value.trim();
      if (!email || !input.checkValidity()) {
        msg.textContent = "Enter a valid email.";
        return;
      }
      const hp = form.querySelector<HTMLInputElement>("[data-newsletter-hp]");
      if (hp && hp.value) {
        // Unreachable by pointer, keyboard, and screen reader, so a value means an
        // automated form-filler. Answer as if it worked rather than teaching it the
        // check exists. The event is the tripwire: this must only ever fire on bots,
        // and bots here do not load PostHog, so any hit means a real visitor was
        // wrongly dropped and the honeypot needs pulling.
        (window as any).posthog?.capture("newsletter_signup_blocked", {
          section: form.dataset.phSection,
        });
        msg.textContent = "Check your email to confirm.";
        input.value = "";
        return;
      }
      sending = true;
      if (button) button.disabled = true;
      msg.textContent = "Sending...";
      try {
        const ok = await subscribe(email).catch(() => false);
        if (ok) {
          msg.textContent = "Check your email to confirm.";
          input.value = "";
          (window as any).posthog?.capture("newsletter_signup", {
            section: form.dataset.phSection,
          });
        } else {
          msg.innerHTML = FAILURE_HTML;
        }
      } finally {
        sending = false;
        if (button) button.disabled = false;
      }
    });
  });
</script>

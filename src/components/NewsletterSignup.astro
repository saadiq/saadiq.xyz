---
// Inline newsletter signup posting to the Ghost Members API at /newsletter.
// Ghost sends the confirmation magic link; no keys involved.
interface Props {
  section: string;
}
const { section } = Astro.props;
---

<form
  data-newsletter-form
  data-ph-section={section}
  class="flex flex-wrap items-center gap-3 max-w-md"
  novalidate
>
  <label class="sr-only" for={`newsletter-email-${section}`}>Email address</label>
  <input
    id={`newsletter-email-${section}`}
    type="email"
    name="email"
    required
    placeholder="you@company.com"
    autocomplete="email"
    class="flex-1 min-w-48 bg-transparent border border-rule px-4 py-2.5 font-mono text-sm text-text placeholder:text-text-muted/50 focus:border-accent focus:outline-none transition-colors"
  />
  <button
    type="submit"
    class="font-mono text-sm text-accent hover:text-accent-hover border border-rule hover:border-accent px-4 py-2.5 transition-colors cursor-pointer disabled:opacity-50 disabled:cursor-wait"
  >
    Subscribe &rarr;
  </button>
  <p data-newsletter-msg class="w-full font-mono text-xs text-text-muted min-h-4" aria-live="polite"></p>
</form>

<script>
  const GHOST_API = "/newsletter/members/api";
  const FAILURE_HTML =
    'That did not go through. <a href="/newsletter" class="text-accent">Subscribe on the newsletter page</a> instead.';

  async function subscribe(email: string): Promise<boolean> {
    let integrityToken = "";
    try {
      const t = await fetch(`${GHOST_API}/integrity-token/`, {
        headers: { "app-pragma": "no-cache" },
      });
      // A fall-through route can answer 200 with an HTML page; only accept a
      // bare token, never a document body.
      if (t.ok) {
        const body = (await t.text()).trim();
        if (body && body.length < 512 && !/[\s<>]/.test(body)) integrityToken = body;
      }
    } catch {
      // Older Ghost versions have no integrity token endpoint.
    }
    const res = await fetch(`${GHOST_API}/send-magic-link/`, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        email,
        emailType: "signup",
        ...(integrityToken ? { integrityToken } : {}),
      }),
    });
    return res.ok;
  }

  document.querySelectorAll<HTMLFormElement>("[data-newsletter-form]").forEach((form) => {
    let sending = false;
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (sending) return;
      const input = form.querySelector<HTMLInputElement>("input[type=email]");
      const msg = form.querySelector<HTMLElement>("[data-newsletter-msg]");
      const button = form.querySelector<HTMLButtonElement>("button[type=submit]");
      if (!input || !msg) return;
      const email = input.value.trim();
      if (!email || !input.checkValidity()) {
        msg.textContent = "Enter a valid email.";
        return;
      }
      sending = true;
      if (button) button.disabled = true;
      msg.textContent = "Sending...";
      try {
        const ok = await subscribe(email).catch(() => false);
        if (ok) {
          msg.textContent = "Check your email to confirm.";
          input.value = "";
          (window as any).posthog?.capture("newsletter_signup", {
            section: form.dataset.phSection,
          });
        } else {
          msg.innerHTML = FAILURE_HTML;
        }
      } finally {
        sending = false;
        if (button) button.disabled = false;
      }
    });
  });
</script>

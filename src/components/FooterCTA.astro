---
import BookingCTA from "./BookingCTA.astro";
import NewsletterSignup from "./NewsletterSignup.astro";

interface Props {
  // The homepage runs on the wider shared container; subpages stay at 5xl.
  wide?: boolean;
}

const { wide = false } = Astro.props;
---

<footer class="pt-16 md:pt-20 pb-32 border-t border-rule">
  <div class={wide ? "container-wide" : "max-w-5xl mx-auto px-6"}>
    <p class="font-display text-2xl md:text-3xl leading-snug mb-10 max-w-3xl">
      Ready to get your team going on AI but can't get traction? Let's talk.
    </p>

    <div class="flex flex-wrap items-center gap-x-8 gap-y-4">
      <BookingCTA section="footer" />
      <a
        href="/newsletter"
        rel="noreferrer"
        class="text-link text-text-muted hover:text-text"
        data-ph-capture="cta_newsletter"
        data-ph-section="footer"
      >
        Read the newsletter &rarr;
      </a>
    </div>
    <p class="mt-3 font-mono text-xs text-text-muted">
      opens my cal.com calendar · no prep needed on your side
    </p>

    <div class="mt-12">
      <p class="text-text-body mb-4">Not ready to book? Get the newsletter instead.</p>
      <NewsletterSignup section="footer" />
    </div>

    <p class="mt-16 font-mono text-xs text-text-muted">
      &copy; 2026 Saadiq Rodgers-King
    </p>
  </div>
</footer>

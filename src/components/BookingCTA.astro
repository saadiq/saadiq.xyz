---
// The one reserved affordance for the primary conversion. `solid` is the
// page-level booking action, `text` is for inline/per-row placements, and
// `outline` is the compact nav pill.
import { BOOKING_URL } from "../lib/constants";

interface Props {
  section: string;
  label?: string;
  variant?: "solid" | "text" | "outline";
}

const { section, label = "Book a conversation", variant = "solid" } = Astro.props;

const variantClass = {
  solid: "text-link bg-accent px-5 text-bg hover:bg-accent-hover",
  text: "text-link text-accent hover:text-accent-hover",
  outline:
    "text-link min-h-9 border border-accent/50 px-3 text-accent hover:border-accent hover:text-accent-hover",
}[variant];
---

<a
  href={BOOKING_URL}
  target="_blank"
  rel="noopener noreferrer"
  class={variantClass}
  data-ph-capture="cta_book_consultation"
  data-ph-section={section}
>
  {label}&nbsp;&rarr;<span class="sr-only"> (opens cal.com in a new tab)</span>
</a>

---
// The four section links plus /newsletter, shared by Nav's desktop bar and
// mobile menu so the list, active state, and analytics attributes have one source.
import { normalizePath } from "../lib/paths";

const links = [
  { href: "/work", label: "Work" },
  { href: "/services", label: "Services" },
  { href: "/speaking", label: "Speaking" },
  { href: "/about", label: "About" },
  // rel=noreferrer: see Member attribution in CLAUDE.md.
  { href: "/newsletter", label: "Newsletter", rel: "noreferrer" },
];

interface Props {
  linkClass?: string;
}

const { linkClass = "" } = Astro.props;
const path = normalizePath(Astro.url.pathname);
---

{
  links.map(({ href, label, rel }) => (
    <a
      href={href}
      rel={rel}
      aria-current={path === href ? "page" : undefined}
      class:list={[
        "items-center transition-colors duration-200",
        linkClass,
        path === href ? "text-text" : "text-text-muted hover:text-text",
      ]}
      data-ph-capture="nav_click"
      data-ph-section="nav"
      data-ph-destination={label.toLowerCase()}
    >
      {label}
    </a>
  ))
}

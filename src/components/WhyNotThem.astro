---
// Each panel pairs an approach the reader has already tried with the reason
// this engagement is different, so the comparison and the pitch are one read.
// Rows in one panel, read across like a ledger, so the homepage doesn't run
// three 3-up card grids back to back.
const approaches = [
  {
    approach: "an internal champion",
    title: "This is my only job.",
    body: "A champion with a day job drifts back to the old way, because it's easier and less risky.",
  },
  {
    approach: "a one-off training",
    title: "It happens in your real work.",
    body: "Generic prompting tips don't connect to anyone's job. I work in your data, your sprints, and your pipeline.",
  },
  {
    approach: "a strategy deck",
    title: "It runs after I leave.",
    body: "A roadmap with no one to build it stays a document. Your team builds the workflows with me, and they keep running.",
  },
];
---

<section class="py-16 md:py-20">
  <div class="container-wide">
    <h2 class="rule-heading mb-10">Why it sticks</h2>

    <div class="panel divide-y divide-rule px-6 md:px-10">
      {approaches.map(({ approach, title, body }) => (
        <div class="grid lg:grid-cols-[13rem_minmax(0,1fr)_minmax(0,1.15fr)] gap-x-10 gap-y-3 py-7 md:py-9 lg:items-baseline">
          <p class="font-mono text-xs" aria-hidden="true">
            <span class="text-text-muted">tried_</span>{" "}
            <span class="text-text">{approach}</span>
          </p>
          <h3 class="font-display text-2xl md:text-3xl leading-tight">
            <span class="sr-only">Tried {approach}: </span>{title}
          </h3>
          <p class="text-text-body leading-relaxed">{body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

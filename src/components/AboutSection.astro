---
import { Image } from "astro:assets";
import portrait from "../assets/images/portrait.jpg";

const metadata = [
  { key: "name_", value: "Saadiq Rodgers-King" },
  { key: "location_", value: "Brooklyn, NY" },
  { key: "experience_", value: "20+ years" },
  { key: "focus_", value: "AI transformation" },
];
---

<section id="about" class="py-16 md:py-20">
  <div class="container-wide">
    <h2 class="sr-only">About</h2>

    <div class="grid md:grid-cols-3 gap-8 md:gap-12">
      <!-- Left column: portrait + metadata -->
      <div>
        <Image
          src={portrait}
          alt="Saadiq Rodgers-King"
          widths={[400, 620, 886]}
          sizes="(min-width: 1312px) 380px, (min-width: 768px) 30vw, 240px"
          class="w-full max-w-60 md:max-w-none border border-rule shadow-panel mb-8"
          loading="lazy"
        />
        <div class="font-mono text-sm space-y-3">
          {
            metadata.map(({ key, value }) => (
              <div>
                <span class="text-text-muted">{key}</span>{" "}
                <span class="text-text">{value}</span>
              </div>
            ))
          }
        </div>
      </div>

      <!-- Right column: prose -->
      <div class="md:col-span-2">
        <p class="text-lg md:text-xl leading-relaxed mb-8">
          I've spent over twenty years in product and engineering, building
          companies and running the teams inside them. I still build with
          these tools every week, so the advice holds up when your team puts
          it to work.
        </p>
        <a
          href="/about"
          class="text-link text-accent hover:text-accent-hover"
          data-ph-capture="cta_about"
          data-ph-section="about_preview"
        >
          More about me &rarr;
        </a>
      </div>
    </div>
  </div>
</section>

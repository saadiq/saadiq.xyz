---
import BookingCTA from "./BookingCTA.astro";
import Mark from "./Mark.astro";
import { EXITS as exits } from "../lib/constants";

// The headline sits beside a nameplate: the Saadiq Industries monogram on a
// cream plate, the one solid block of light above the fold. The plate replaced
// the hero photo (2026-11-25); the portrait lives in About. Credentials run as
// one mono strip under both, so the exits are still said exactly once.
---

<section class="pt-36 md:pt-44 pb-12 md:pb-16">
  <div class="container-wide">
    <div class="flex flex-wrap items-stretch gap-10 md:gap-14">
      <div class="flex min-w-0 flex-[999_1_36rem] flex-col justify-between gap-10 md:gap-12">
        <h1 class="font-display font-extrabold text-5xl md:text-7xl lg:text-8xl xl:text-[7.25rem] leading-[0.95] md:leading-[0.92] tracking-[-0.045em]">
          AI changes how companies run. I help CEOs <span class="text-accent">decide how theirs will.</span><span class="cursor-blink text-accent" aria-hidden="true">_</span>
        </h1>
        <div class="flex flex-wrap items-end justify-between gap-8">
          <p class="text-lg md:text-xl text-text-body max-w-[38rem] leading-relaxed">
            I help CEOs get fluent on AI, decide what it changes about the business, and set the next moves. Then I work with their product and technology teams until it's how the work gets done.
          </p>
          <div class="flex flex-wrap items-center gap-x-8 gap-y-4">
            <BookingCTA section="hero" />
            <a
              href="#case-studies"
              class="text-link text-accent hover:text-accent-hover"
              data-ph-capture="cta_case_studies"
              data-ph-section="hero"
            >
              Case studies &darr;
            </a>
          </div>
        </div>
      </div>

      <div class="hidden md:flex flex-[1_1_18rem] max-w-[22rem] min-h-[27rem] flex-col justify-between gap-8 bg-text p-7 text-bg shadow-panel" aria-hidden="true">
        <div class="flex justify-between font-mono text-xs">
          <span>SAADIQ INDUSTRIES</span>
          <span>AI STRATEGY</span>
        </div>
        <Mark class="w-[72%] self-center" />
        <div class="border-t border-bg pt-3 font-mono text-xs leading-relaxed">
          Saadiq Rodgers-King<br />Brooklyn, NY
        </div>
      </div>
    </div>

    <div class="mt-12 md:mt-14 flex flex-wrap gap-x-10 gap-y-2 border-t border-rule pt-5 font-mono text-sm">
      <p>
        <span class="text-text-muted">advising_</span>{" "}
        <span class="text-text">CEOs and founders, from the Fortune 500 to nonprofits</span>
      </p>
      <p>
        <span class="text-text-muted">exits_</span>{" "}
        <span class="text-text">{exits.join(" · ")}</span>
      </p>
      <p>
        <span class="text-text-muted">before_</span>{" "}
        <span class="text-text">Princeton CS · MIT Sloan MBA</span>
      </p>
    </div>
  </div>
</section>

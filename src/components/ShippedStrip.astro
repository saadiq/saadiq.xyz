---
// First-party proof on the homepage: every study in work-data.ts that carries
// a verified metric. Stats and Tracks are other people's numbers; this is the
// section that says what I shipped, so it sits directly after Stats.
import BookingCTA from "./BookingCTA.astro";
import {
  caseStudyCount,
  displayName,
  featuredStudies,
} from "../lib/work-data";
---

<section id="shipped" class="py-20 md:py-28">
  <div class="container-wide">
    <h2 class="rule-heading mb-12">What shipped</h2>
    <div class="grid md:grid-cols-2 gap-6">
      {
        featuredStudies.map((cs, i) => {
          // The first study leads full width, number beside its label, so the
          // larger card is filled by larger type rather than empty space. The
          // rest pair up beneath it.
          const lead = i === 0;
          return (
            <a
              href="/work"
              class:list={[
                "panel panel-accent flex flex-col group",
                lead
                  ? "md:col-span-2 gap-6 p-6 md:grid md:grid-cols-2 md:items-end md:gap-x-12 md:gap-y-10 md:p-12"
                  : "gap-3 p-6 md:px-10 md:py-8",
              ]}
              data-ph-capture="cta_work"
              data-ph-section="shipped_strip"
            >
              <p class:list={[
                "font-display leading-[0.9] tracking-tight whitespace-nowrap text-accent group-hover:text-accent-hover transition-colors",
                lead ? "text-7xl md:text-7xl lg:text-8xl xl:text-9xl" : "text-6xl md:text-6xl lg:text-7xl xl:text-8xl",
              ]}>
                {cs.metric.value}
              </p>
              <p class:list={[
                "font-display leading-snug text-text",
                lead ? "text-2xl md:text-3xl lg:text-4xl max-w-lg" : "text-xl md:text-2xl",
              ]}>
                {cs.metric.label}
              </p>
              <div class:list={["mt-auto pt-4 border-t border-rule space-y-1", lead && "md:col-span-2"]}>
                <p class="font-mono text-sm text-text">{displayName(cs)}</p>
                <p class="font-mono text-xs text-text-muted">
                  {cs.format.join(" · ")}
                </p>
              </div>
            </a>
          );
        })
      }
    </div>
    <div class="mt-12 flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6">
      <p class="text-lg text-text-body max-w-xl">
        {caseStudyCount} engagements, anonymized until each client signs a
        release. The details stay exact.
      </p>
      <div class="flex flex-wrap items-center gap-x-8 gap-y-4">
        <a
          href="/work"
          class="text-link text-accent hover:text-accent-hover"
          data-ph-capture="cta_work"
          data-ph-section="shipped_strip"
        >
          All {caseStudyCount} &rarr;
        </a>
        <BookingCTA section="shipped_strip" />
      </div>
    </div>
  </div>
</section>

---
import { contentApiUrl, getRecentPosts } from "../lib/ghost";
import type { GhostPost } from "../lib/ghost";
import NewsletterSignup from "./NewsletterSignup.astro";

let posts: GhostPost[] = [];
try {
  posts = await getRecentPosts(3);
} catch (e) {
  console.error("Failed to fetch Ghost posts:", e);
}
---

<section
  id="newsletter-preview"
  class="py-16 md:py-20"
  hidden={posts.length === 0}
>
  <div class="container-wide">
    <h2 class="rule-heading mb-10">From the newsletter</h2>

    <div data-posts class="grid md:grid-cols-3 gap-6">
      {posts.map((post) => (
        <div class="panel flex flex-col gap-3 p-6 md:p-8">
          <div class="flex gap-4">
            <span class="font-mono text-xs text-text-muted">
              {new Date(post.published_at).toLocaleDateString("en-GB", {
                day: "2-digit",
                month: "short",
                year: "numeric",
              })}
            </span>
            <span class="font-mono text-xs text-text-muted">
              {post.reading_time} min read
            </span>
          </div>
          <a
            href={`/newsletter/${post.slug}/`}
            rel="noreferrer"
            class="font-display text-2xl md:text-[1.75rem] leading-tight hover:text-accent transition-colors"
          >
            {post.title}
          </a>
          <p class="text-text-body text-sm leading-relaxed line-clamp-3">
            {post.excerpt}
          </p>
        </div>
      ))}
    </div>

    <div class="mt-10 flex flex-col lg:flex-row lg:items-baseline lg:justify-between gap-6">
      <div class="flex flex-col md:flex-row md:items-baseline gap-4 md:gap-6">
        <p class="text-text-body shrink-0">Get the next one in your inbox.</p>
        <NewsletterSignup section="newsletter_preview" />
      </div>
      <a
        href="/newsletter"
        rel="noreferrer"
        class="text-link text-accent hover:text-accent-hover shrink-0"
        data-ph-capture="cta_newsletter"
        data-ph-section="newsletter_preview"
      >
        Read all posts &rarr;
      </a>
    </div>
  </div>
</section>

<!-- Re-fetch in the browser so new posts show up without a site rebuild. -->
<script define:vars={{ apiUrl: contentApiUrl(3) }}>
  const section = document.getElementById("newsletter-preview");
  const list = section.querySelector("[data-posts]");

  const esc = (s) =>
    String(s).replace(
      /[&<>"']/g,
      (c) =>
        ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c],
    );

  const fmtDate = (iso) =>
    new Date(iso).toLocaleDateString("en-GB", {
      day: "2-digit",
      month: "short",
      year: "numeric",
    });

  fetch(apiUrl)
    .then((res) => (res.ok ? res.json() : Promise.reject(new Error(res.status))))
    .then(({ posts }) => {
      if (!posts || posts.length === 0) return;
      // Markup mirrors the server-rendered template above — keep them in sync.
      list.innerHTML = posts
        .map(
          (post) => `
        <div class="panel flex flex-col gap-3 p-6 md:p-8">
          <div class="flex gap-4">
            <span class="font-mono text-xs text-text-muted">${fmtDate(post.published_at)}</span>
            <span class="font-mono text-xs text-text-muted">${post.reading_time} min read</span>
          </div>
          <a href="/newsletter/${esc(post.slug)}/" rel="noreferrer" class="font-display text-2xl md:text-[1.75rem] leading-tight hover:text-accent transition-colors">${esc(post.title)}</a>
          <p class="text-text-body text-sm leading-relaxed line-clamp-3">${esc(post.excerpt ?? "")}</p>
        </div>`,
        )
        .join("");
      section.hidden = false;
    })
    .catch(() => {
      // Build-time content (if any) stays in place.
    });
</script>

---
// The span of the work, from the executive's decisions to production code. The
// product is the expertise; building is what keeps it credible, so advisory
// leads and builds are offered where they prove a point, not as the main sale.
// A ruled list of three big words, read top to bottom as a sequence; its form
// differs from the case-study cards above on purpose. The full lineup lives on
// /services; each step links to its service there.
import { assertServiceSlugs, services } from "../lib/services-data";

const steps = [
  {
    label: "Advise",
    covers: "Executive advisory, talks",
    slug: "advisory",
    body: "A standing weekly session with the CEO on what matters, what to safely ignore, and what competitors are doing. Current clients include the chief executive of a Fortune 500 company. The usual starting point.",
  },
  {
    label: "Scope",
    covers: "Discovery sprint",
    slug: "sprint",
    body: "One to two weeks inside your company to find which problem is worth solving first. Ends with a scoped proposal for the first project.",
  },
  {
    label: "Build",
    covers: "Agent builds, embedded technical leadership",
    slug: "builds",
    body: "Some questions only get answered once something is running. Then I build it with your team, as a scoped project or as your weekly technical lead. Your team owns it after.",
  },
];

assertServiceSlugs(steps.map((s) => s.slug), "ServicesTeaser");
---

<section id="services" class="py-16 md:py-20">
  <div class="container-wide">
    <h2 class="rule-heading mb-4">How I work</h2>
    {steps.map(({ label, covers, slug, body }, i) => {
      const num = String(i + 1).padStart(2, "0");
      return (
        <a
          href={`/services#${slug}`}
          class="group grid gap-x-12 gap-y-3 border-b border-rule py-8 md:grid-cols-[minmax(0,1fr)_minmax(0,1.4fr)_minmax(0,0.8fr)] md:items-baseline"
          data-ph-capture="cta_services"
          data-ph-section="services_teaser"
          data-ph-destination={slug}
          aria-labelledby={`step-${slug}`}
        >
          <h3 id={`step-${slug}`} class="display-heavy text-5xl md:text-6xl lg:text-7xl leading-none text-text transition-colors group-hover:text-accent">
            {label}
          </h3>
          <p class="text-text-body leading-relaxed">{body}</p>
          <p class="font-mono text-xs text-text-muted">
            <span aria-hidden="true">{num} · </span>{covers}
          </p>
        </a>
      );
    })}
    <a
      href="/services"
      class="mt-10 text-link text-accent hover:text-accent-hover"
      data-ph-capture="cta_services"
      data-ph-section="services_teaser"
    >
      All {services.length} ways to work &rarr;
    </a>
  </div>
</section>
